---
import type { Publication } from '../data/content';
import {localUrl} from '../config';
import {publicationAbstracts} from '../data/content';
interface Props { publication: Publication; compact?: boolean; }
const {publication:p, compact=false} = Astro.props;
const abstract = compact ? undefined : publicationAbstracts.get(p.id);
const abstractHeading = abstract?.text_type.startsWith('Detailed study summary') ? 'Study summary' : abstract?.text_type.startsWith('Author summary') ? 'Summary' : 'Abstract';
const scholarQuery = p.id === 'pub-2004-28' ? '"Hypnosis" "Benham" "Nash" "Oken"' : `"${p.title}" "Benham"`;
const scholarUrl = `https://scholar.google.com/scholar?${new URLSearchParams({q:scholarQuery})}`;
---
<article id={p.id} class:list={['citation', {compact, 'publication-entry': !compact}]} data-archive-item={!compact || undefined} data-year={p.year} data-type={p.type} data-topics={JSON.stringify(p.topics)} data-search={`${p.citation} ${p.topics.join(' ')} ${p.doi || ''}`}>
  <div class="citation-meta"><span>{p.year}</span><span>{p.type}</span></div>
  <h3>{compact ? <a href={localUrl(`/publications/#${p.id}`)}>{p.title}</a> : p.title}</h3>
  <p class="citation-text">{p.citation}</p>
  <div class="citation-links">
    {p.doi && <a href={`https://doi.org/${p.doi}`}>DOI: {p.doi} <span aria-hidden="true">→</span></a>}
    {!compact && <a href={scholarUrl}>Google Scholar <span aria-hidden="true">→</span><span class="sr-only">: {p.title}</span></a>}
    {compact && p.topics.map(topic => <span class="tag">{topic}</span>)}
  </div>
  {abstract && <details class="publication-abstract">
    <summary><span class="abstract-show">Show abstract</span><span class="abstract-hide">Hide abstract</span><span class="sr-only">: {p.title}</span></summary>
    <div class="abstract-content"><h4>{abstractHeading}</h4><p>{abstract.abstract}</p></div>
  </details>}
  {p.reviewNote && <p class="content-note">{p.reviewNote}</p>}
</article>
