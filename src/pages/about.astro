---
import {site, localUrl} from '../config';
const destination = localUrl('/#about');
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>About | Grant Benham</title><meta http-equiv="refresh" content={`0;url=${destination}`} /><link rel="canonical" href={new URL(destination, site.url).href} /></head><body><p><a href={destination}>About Grant Benham is now on the home page.</a></p></body></html>
