---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import {alumni} from '../data/content';
import {site, localUrl} from '../config';
const nameLines = (name: string) => {
  const words = name.split(' ');
  const first = words.splice(0, words[0] === 'Dr.' ? 2 : 1).join(' ');
  return [first, words.join(' ')];
};
---
<Layout title="Lab" description={`Research and mentorship in the ${site.labName} at UTRGV.`}>
  <div class="container page-content">
    <PageHeading title={site.labName} intro="Research and Mentorship" />
    <div class="two-columns"><section class="prose"><h2>About the lab</h2><p>The lab brings together psychological, behavioral, and physiological approaches to the study of stress, sleep, and health. Its work includes research on sensory processing sensitivity and other individual differences.</p><p>Student collaboration is reflected in the lab’s publications and conference presentations. Research projects have included self-report studies and physiological measures such as heart rate variability.</p><a class="text-link" href={localUrl('/research/')}>Explore the research →</a></section><section class="contact-card"><h2>Research mentorship</h2><p>Students interested in research mentorship can contact Grant Benham to discuss their interests and inquire about current opportunities.</p><a class="text-link" href={`mailto:${site.email}`}>Contact Grant Benham →</a></section></div>
    <section class="content-section"><h2>Lab alumni</h2><h3 class="alumni-subheading">2017 onwards</h3><p class="alumni-instruction">[Click on photo to open LinkedIn page]</p>
      {alumni.length ? <div class="alumni-grid">{alumni.map(person => <article class="alumni-card">{person.photo ? (person.linkedin ? <a class="alumni-photo-link" href={person.linkedin} aria-label={`${person.name} on LinkedIn`}><img src={localUrl(person.photo)} alt={person.photoAlt || person.name} width="120" height="120" loading="lazy" /></a> : <img src={localUrl(person.photo)} alt={person.photoAlt || person.name} width="120" height="120" loading="lazy" />) : <div class="photo-placeholder" aria-hidden="true">Photograph forthcoming</div>}<h3>{nameLines(person.name).map((line, index) => <span class="alumni-name-line">{index > 0 && ' '}{line}</span>)}</h3>{person.years && <p>{person.years}</p>}{person.description && <p>{person.description}</p>}</article>)}</div> : <div class="empty-state"><p>Alumni photographs and profiles are being prepared for this website.</p><p class="muted">Historical lab members will be listed as alumni, rather than assumed to be current members.</p></div>}
    </section>
    <section class="content-section"><div class="section-heading"><h2>Student research</h2><a class="text-link" href={localUrl('/presentations/')}>Conference presentation archive →</a></div><p class="prose">The presentation archive documents student-led and collaborative research across multiple conference venues, including the Association for Psychological Science and the Southwestern Psychological Association.</p></section>
  </div>
</Layout>
