---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import {software} from '../data/content';
---
<Layout title="Software" description="Research software and analytical tools: gbMod, gbMed, gbEFA, and BioKubios.">
  <div class="container page-content">
    <PageHeading title="Software" intro="Software developed by Dr. Grant Benham" />
    <div class="software-grid">{software.map(tool => <article id={tool.id} class="software-card"><p class="eyebrow">{tool.category}</p><h2>{tool.name}</h2><p>{tool.description}</p><div class="link-list">{tool.application && <a class="text-link" href={tool.application}>Open application →</a>}{tool.repository && <a class="text-link" href={tool.repository}>GitHub source →</a>}{tool.documentation && <a class="text-link" href={tool.documentation}>Documentation →</a>}</div>{tool.reviewNote && <p class="content-note">{tool.reviewNote}</p>}</article>)}</div>
  </div>
</Layout>
